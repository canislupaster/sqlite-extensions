{
	"name": "sqlite-extensions",
	"version": "1.0.0",
	"description": "All SQLite extensions",
	"type": "module",
	"packageManager": "pnpm@12.0.0",
	"main": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"default": "./lib/index.js"
		}
	},
	"files": [
		"lib"
	],
	"scripts": {
		"build": "pnpm tsc && pnpm esbuild index.ts --outfile=lib/index.js --bundle --format=esm --platform=node --minify --sourcemap",
		"lint": "tsc --noEmit",
		"test": "pnpm build && node --test index.spec.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/canislupaster/sqlite-extensions"
	},
	"license": "MIT",
	"author": {
		"name": "Thomas Marlowe",
		"email": "thomas@thomasqm.com",
		"url": "https://thomasqm.com"
	},
	"engines": {
		"node": ">=22",
		"pnpm": ">=12"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^25.0.0",
			"onFail": "error"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "^12.0.0",
			"onFail": "error"
		}
	},
	"keywords": [
		"sqlite",
		"sqlite3",
		"better-sqlite3",
		"extensions",
		"fuzzy",
		"search",
		"spellfix",
		"csv",
		"series",
		"regexp",
		"uuid",
		"decimal",
		"percentile",
		"fileio",
		"sha1",
		"zipfile"
	],
	"bugs": {
		"url": "https://github.com/canislupaster/sqlite-extensions/issues"
	},
	"homepage": "https://github.com/canislupaster/sqlite-extensions",
	"devDependencies": {
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.3.0",
		"better-sqlite3": "^13.0.3",
		"esbuild": "^0.28.2",
		"typescript": "^7.0.2"
	}
}